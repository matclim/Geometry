#
# Cavern visibility for the Phoenix viewer.
#
# `depth` = number of generations to keep below the subsystem envelope
# during glTF export. depth=0 → envelope only; deeper geometry is detached
# from the tree before export so the exporter doesn't recurse.

depth = 0
